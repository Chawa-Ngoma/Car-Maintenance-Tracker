<Window x:Class="CarMaintenanceTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CarMaintenanceTracker"
        mc:Ignorable="d"
        Title="Car Maintenance Tracker (Phase 3 - temporary UI)" Height="500" Width="900">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Vehicles: temporary list, replaced by Views/VehicleEditView.xaml in Phase 4 -->
        <DockPanel Grid.Column="0" Margin="4">
            <TextBlock DockPanel.Dock="Top" Text="Vehicles" FontWeight="Bold" Margin="0,0,0,4" />
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
                <Button Content="Add" Command="{Binding AddVehicleCommand}" Margin="0,0,4,0" />
                <Button Content="Save" Command="{Binding SaveVehicleCommand}" Margin="0,0,4,0" />
                <Button Content="Delete" Command="{Binding DeleteVehicleCommand}" />
            </StackPanel>
            <ListBox ItemsSource="{Binding Vehicles}" SelectedItem="{Binding SelectedVehicle}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding Nickname, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                            <TextBox Text="{Binding Make, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="4,0,0,0" />
                            <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="4,0,0,0" />
                            <TextBox Text="{Binding Year, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="4,0,0,0" />
                            <TextBox Text="{Binding Plate, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="4,0,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Service log for the selected vehicle: temporary list, replaced by Views/ServiceEntryEditView.xaml in Phase 4 -->
        <DockPanel x:Name="ServiceLogPanel" Grid.Column="1" Margin="4">
            <TextBlock DockPanel.Dock="Top" Text="Service Log" FontWeight="Bold" Margin="0,0,0,4" />
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
                <Button Content="Add" Command="{Binding AddEntryCommand}" Margin="0,0,4,0" />
                <Button Content="Save" Command="{Binding SaveEntryCommand}" Margin="0,0,4,0" />
                <Button Content="Delete" Command="{Binding DeleteEntryCommand}" />
            </StackPanel>
            <ListBox ItemsSource="{Binding ServiceEntries}" SelectedItem="{Binding SelectedEntry}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding Date, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                            <TextBox Text="{Binding Odometer, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="4,0,0,0" />
                            <TextBox Text="{Binding ServiceType, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="4,0,0,0" />
                            <TextBox Text="{Binding Cost, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="4,0,0,0" />
                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="4,0,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Grid>
</Window>
