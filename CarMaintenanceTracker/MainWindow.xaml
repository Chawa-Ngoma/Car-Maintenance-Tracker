<Window x:Class="CarMaintenanceTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CarMaintenanceTracker"
        xmlns:views="clr-namespace:CarMaintenanceTracker.Views"
        mc:Ignorable="d"
        Title="Car Maintenance Tracker" Height="550" Width="950">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Vehicles -->
        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="Vehicles" FontWeight="Bold" FontSize="14" />
            <views:VehicleEditView DockPanel.Dock="Bottom" />
            <ListBox ItemsSource="{Binding Vehicles}" SelectedItem="{Binding SelectedVehicle}" Margin="0,4,0,0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Vertical" Margin="2">
                            <TextBlock Text="{Binding Nickname}" FontWeight="SemiBold" />
                            <TextBlock>
                                <Run Text="{Binding Make, Mode=OneWay}" />
                                <Run Text="{Binding Model, Mode=OneWay}" />
                                <Run Text="(" /><Run Text="{Binding Year, Mode=OneWay}" /><Run Text=")" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Service log for the selected vehicle -->
        <DockPanel x:Name="ServiceLogPanel" Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="Service Log" FontWeight="Bold" FontSize="14" />
            <views:ServiceEntryEditView DockPanel.Dock="Bottom" />
            <ListBox ItemsSource="{Binding ServiceEntries}" SelectedItem="{Binding SelectedEntry}" Margin="0,4,0,0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Vertical" Margin="2">
                            <TextBlock>
                                <Run Text="{Binding Date, Mode=OneWay, StringFormat=d}" />
                                <Run Text="-" />
                                <Run Text="{Binding ServiceType, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock>
                                <Run Text="{Binding Cost, Mode=OneWay, StringFormat=C}" />
                                <Run Text="@" />
                                <Run Text="{Binding Odometer, Mode=OneWay}" />
                                <Run Text="mi" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Grid>
</Window>
