<UserControl x:Class="CarMaintenanceTracker.Views.ServiceEntryEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:CarMaintenanceTracker.Converters"
             mc:Ignorable="d"
             d:DesignHeight="240" d:DesignWidth="300">
    <UserControl.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <converters:NotNullToBooleanConverter x:Key="NotNullToBooleanConverter" />
    </UserControl.Resources>
    <StackPanel Margin="0,8,0,0"
                IsEnabled="{Binding SelectedEntry, Converter={StaticResource NotNullToBooleanConverter}}">
        <TextBlock Text="Edit Service Entry" FontWeight="Bold" Margin="0,0,0,4" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Date" VerticalAlignment="Center" />
            <DatePicker Grid.Row="0" Grid.Column="1" Margin="0,2"
                        SelectedDate="{Binding SelectedEntry.Date, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Odometer" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2"
                     Text="{Binding SelectedEntry.Odometer, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Service Type" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,2"
                     Text="{Binding SelectedEntry.ServiceType, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Cost" VerticalAlignment="Center" />
            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,2"
                     Text="{Binding SelectedEntry.Cost, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Notes" VerticalAlignment="Center" />
            <TextBox Grid.Row="4" Grid.Column="1" Margin="0,2"
                     Text="{Binding SelectedEntry.Notes, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Add New" Command="{Binding AddEntryCommand}" Margin="0,0,4,0" Padding="6,2" />
            <Button Content="Save" Command="{Binding SaveEntryCommand}" Margin="0,0,4,0" Padding="6,2"
                    IsEnabled="{Binding SelectedEntry.HasErrors, Converter={StaticResource InverseBooleanConverter}, FallbackValue=False}" />
            <Button Content="Delete" Click="DeleteButton_Click" Padding="6,2" />
        </StackPanel>
    </StackPanel>
</UserControl>
