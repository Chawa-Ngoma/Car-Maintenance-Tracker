<UserControl x:Class="CarMaintenanceTracker.Views.ChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:oxy="http://oxyplot.org/wpf"
             xmlns:converters="clr-namespace:CarMaintenanceTracker.Converters"
             mc:Ignorable="d"
             d:DesignHeight="200" d:DesignWidth="500">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid MinHeight="180">
        <oxy:PlotView Model="{Binding PlotModel}"
                      Background="Transparent"
                      Visibility="{Binding HasEnoughData, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding HasEnoughData, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <TextBlock Text="&#128200;" FontSize="28" HorizontalAlignment="Center"
                       Foreground="{StaticResource SecondaryBrush}" Margin="0,0,0,8" />
            <TextBlock Text="Add at least 2 service entries for this vehicle to see a cost trend"
                       Style="{StaticResource SubtitleTextStyle}"
                       HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="260" />
        </StackPanel>
    </Grid>
</UserControl>
